actionId: llm
name: Generate Reply

validations:
  # Status callbacks (sent, delivered, read) carry no text message: nothing to answer.
  skip:
    - "{% raw %}(input('entry')?.[0]?.changes?.[0]?.value?.messages?.[0]?.text?.body ?? '') == ''{% endraw %}"

chat:
  model:
    name: llama3.2:1b  # llamafile alias - auto-downloaded to ~/.kdeps/models (~1.1 GB, first run only)
    timeout: 60s
  context:
    scenario:
      - role: assistant
        prompt: Answer in a few short sentences, in the language of the message.
    prompt: "{% raw %}{{ input('entry')[0].changes[0].value.messages[0].text.body }}{% endraw %}"
