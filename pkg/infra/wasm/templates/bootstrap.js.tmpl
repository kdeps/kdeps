(function() {
    const __kdepsWorkflowYAML = `{{.WorkflowYAML}}`;
    const __kdepsAPIRoutes = {{.APIRoutesJSON}};

    function isFileOrigin() {
        return typeof location !== 'undefined' && location.protocol === 'file:';
    }

    // Legacy manual decoder. Only used by the fetch shim's fallback path now -
    // the main load route (loadKdepsWasm) hands the base64 straight to a
    // data: URL so the browser decodes it natively, off the JS thread.
    function wasmBytesFromEmbed() {
        var b64 = window.__KDEPS_WASM_B64;
        if (typeof b64 !== 'string' || b64.length === 0) return null;
        var binary = atob(b64);
        var bytes = new Uint8Array(binary.length);
        for (var i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
        return bytes;
    }

    function isKdepsWasmURL(url) {
        var s = String(url || '');
        try {
            var base = (typeof location !== 'undefined' && location.href) ? location.href : 'http://localhost/';
            s = new URL(s, base).pathname || s;
        } catch (e) { /* keep s */ }
        return /(?:^|\/)kdeps\.wasm$/i.test(s.split('?')[0]);
    }

    function installFileOriginFetchShim() {
        if (typeof window.fetch !== 'function') return;
        var orig = window.fetch.bind(window);
        window.fetch = function(resource, init) {
            var url = '';
            try {
                if (typeof resource === 'string') url = resource;
                else if (resource && typeof resource.url === 'string') url = resource.url;
                else url = String(resource);
            } catch (e) {
                url = String(resource);
            }
            if (isKdepsWasmURL(url)) {
                var bytes = wasmBytesFromEmbed();
                if (bytes) {
                    return Promise.resolve(new Response(bytes, {
                        status: 200,
                        headers: { 'Content-Type': 'application/wasm' }
                    }));
                }
                return Promise.reject(new Error('[kdeps] blocked fetch of kdeps.wasm (embed missing)'));
            }
            if (isFileOrigin() && typeof resource === 'string') {
                var next = {};
                if (init) {
                    var keys = Object.keys(init);
                    for (var i = 0; i < keys.length; i++) next[keys[i]] = init[keys[i]];
                }
                if (next.credentials == null) next.credentials = 'omit';
                if (next.referrerPolicy == null) next.referrerPolicy = 'no-referrer';
                return orig(resource, next);
            }
            return orig(resource, init);
        };
    }

    // loadKdepsWasm resolves the module without the multi-megabyte synchronous
    // atob + charCodeAt loop the old path ran on the main thread: it wraps the
    // embedded base64 in a data: URL and lets the browser decode + stream-
    // compile it. instantiateStreaming keeps the compile incremental; the
    // buffered fetch is the Safari fallback (no streaming from data:).
    async function loadKdepsWasm(go) {
        var b64 = window.__KDEPS_WASM_B64;
        if (typeof b64 === 'string' && b64.length) {
            var dataURL = 'data:application/wasm;base64,' + b64;
            try {
                return await WebAssembly.instantiateStreaming(fetch(dataURL), go.importObject);
            } catch (e) {
                var buf = await (await fetch(dataURL)).arrayBuffer();
                return await WebAssembly.instantiate(buf, go.importObject);
            }
        }
        return WebAssembly.instantiateStreaming(fetch('kdeps.wasm'), go.importObject);
    }

    function settingsEnv() {
        try {
            return (typeof window.__kdepsSettingsEnv === 'function') ? window.__kdepsSettingsEnv() : {};
        } catch (e) { return {}; }
    }

    function installAPIRouteInterceptor() {
        if (__kdepsAPIRoutes.length === 0) return;
        var _originalFetch = window.fetch;
        window.fetch = function(resource, init) {
            try {
                var url = typeof resource === 'string' ? resource : (resource instanceof Request ? resource.url : String(resource));
                var parsed = new URL(url, window.location.origin);
                var pathname = parsed.pathname;
                for (var i = 0; i < __kdepsAPIRoutes.length; i++) {
                    if (pathname === __kdepsAPIRoutes[i] || pathname.startsWith(__kdepsAPIRoutes[i] + '/')) {
                        return __kdepsHandleAPIRequest(pathname, init);
                    }
                }
            } catch (e) { /* fall through */ }
            return _originalFetch.call(window, resource, init);
        };
        console.log('[kdeps] Fetch interceptor installed for', __kdepsAPIRoutes.length, 'API route(s).');
    }

    async function boot() {
        try {
            if (typeof WebAssembly === 'undefined') {
                console.error('[kdeps] WebAssembly is not supported in this browser.');
                window.dispatchEvent(new Event('kdeps:error'));
                return;
            }

            installFileOriginFetchShim();

            const go = new Go();
            const result = await loadKdepsWasm(go);
            go.run(result.instance);
            // The 45MB string has served its purpose - let it be collected.
            try { window.__KDEPS_WASM_B64 = ''; } catch (e) { /* frozen */ }

            await new Promise(resolve => setTimeout(resolve, 0));

            await kdepsInit(__kdepsWorkflowYAML, settingsEnv());

            window.addEventListener('kdeps:settings-changed', function() {
                kdepsInit(__kdepsWorkflowYAML, settingsEnv()).catch(function(err) {
                    console.error('[kdeps] re-init after settings change failed:', err);
                });
            });

            window.kdeps = {
                execute: function(input) {
                    var inputJSON = typeof input === 'string' ? input : JSON.stringify(input);
                    return kdepsExecute(inputJSON);
                },
                stream: function(input, callback) {
                    var inputJSON = typeof input === 'string' ? input : JSON.stringify(input);
                    return kdepsExecute(inputJSON, callback);
                },
                validate: function() {
                    return kdepsValidate(__kdepsWorkflowYAML);
                },
                init: function(env) {
                    return kdepsInit(__kdepsWorkflowYAML, env || {});
                }
            };

            installAPIRouteInterceptor();

            window.dispatchEvent(new Event('kdeps:ready'));
            console.log('[kdeps] WASM runtime ready.');
        } catch (err) {
            console.error('[kdeps] Init error:', err);
            window.dispatchEvent(new Event('kdeps:error'));
        }
    }

    // Signal "loading has started" synchronously so the UI can show a spinner,
    // then defer the heavy compile until the page has painted that UI. The WASM
    // still compiles on the main thread (a Worker can't be used from file://),
    // but the page is visible and responsive-looking the whole time instead of
    // frozen behind a blank tab.
    try { window.dispatchEvent(new Event('kdeps:loading')); } catch (e) {}

    function schedule() {
        if (typeof requestAnimationFrame === 'function') {
            requestAnimationFrame(function() { requestAnimationFrame(function() { setTimeout(boot, 0); }); });
        } else {
            setTimeout(boot, 0);
        }
    }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', schedule);
    } else {
        schedule();
    }

    async function __kdepsHandleAPIRequest(pathname, init) {
        var method = (init && init.method) ? init.method.toUpperCase() : 'GET';
        var headers = {};
        if (init && init.headers) {
            var h = new Headers(init.headers);
            h.forEach(function(v, k) { headers[k] = v; });
        }

        var body = null;
        if (init && init.body) {
            try {
                body = typeof init.body === 'string' ? JSON.parse(init.body) : init.body;
            } catch (e) {
                body = { _raw: init.body };
            }
        }

        var requestCtx = {
            _kdeps_request: true,
            method: method,
            path: pathname,
            headers: headers,
            query: {},
            body: body || {}
        };

        try {
            var parsed = new URL(pathname, window.location.origin);
            parsed.searchParams.forEach(function(v, k) { requestCtx.query[k] = v; });
        } catch (e) { /* no query */ }

        try {
            var result = await window.kdeps.execute(requestCtx);
            var responseBody = typeof result === 'string' ? result : JSON.stringify(result);
            return new Response(responseBody, {
                status: 200,
                headers: { 'Content-Type': 'application/json' }
            });
        } catch (err) {
            return new Response(JSON.stringify({ error: err.message || String(err) }), {
                status: 500,
                headers: { 'Content-Type': 'application/json' }
            });
        }
    }
})();
