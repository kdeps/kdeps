actionId: reply
name: Send WhatsApp Reply
flow:
  requires:
    - llm

validations:
  skip:
    - "{% raw %}(input('entry')?.[0]?.changes?.[0]?.value?.messages?.[0]?.text?.body ?? '') == ''{% endraw %}"

# WhatsApp Cloud API: send the answer back to the sender's number.
component:
  name: whatsapp_post
  with:
    path: "{% raw %}v23.0/{{ env('WHATSAPP_PHONE_NUMBER_ID') }}/messages{% endraw %}"
    body:
      messaging_product: whatsapp
      to: "{% raw %}{{ input('entry')[0].changes[0].value.messages[0].from }}{% endraw %}"
      type: text
      text:
        body: "{% raw %}{{ get('llm').message.content }}{% endraw %}"
