{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata"
  ],
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": [
        "kdeps.io/v1"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "Workflow"
      ]
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "targetActionId"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "targetActionId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "deploy": {
      "type": "object",
      "description": "How the workflow is served: servers, TLS, input sources, and runtime.",
      "properties": {
        "apiServer": {
          "type": "object",
          "properties": {
            "hostIp": {
              "type": "string"
            },
            "portNum": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "routes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^/"
                  },
                  "methods": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "GET",
                        "POST",
                        "PUT",
                        "DELETE",
                        "PATCH"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "webServer": {
          "type": "object"
        },
        "certFile": {
          "type": "string"
        },
        "keyFile": {
          "type": "string"
        },
        "letsEncrypt": {
          "type": "object"
        },
        "input": {
          "type": "object",
          "required": [
            "sources"
          ],
          "properties": {
            "sources": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "api",
                  "bot",
                  "file"
                ]
              }
            },
            "bot": {
              "type": "object",
              "properties": {
                "executionType": {
                  "type": "string",
                  "enum": [
                    "polling",
                    "stateless"
                  ]
                },
                "discord": {
                  "type": "object",
                  "properties": {
                    "guildId": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "slack": {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "telegram": {
                  "type": "object",
                  "properties": {
                    "pollIntervalSeconds": {
                      "type": "integer"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "file": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "runtime": {
          "type": "object",
          "properties": {
            "timezone": {
              "type": "string"
            },
            "pythonVersion": {
              "type": "string"
            },
            "pythonPackages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "requirementsFile": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "memory": {
      "type": "object"
    },
    "agent": {
      "type": "object"
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "evals": {
      "type": "array",
      "description": "Eval cases run by kdeps test against the workflow's own router.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "request"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "timeout": {
            "type": "string",
            "description": "Per-case timeout (e.g. 30s). Defaults to 30s."
          },
          "request": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "method": {
                "type": "string",
                "description": "HTTP method (GET, POST, PUT, DELETE, PATCH). Defaults to GET."
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "query": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "body": {
                "description": "Request body, encoded as JSON."
              }
            },
            "additionalProperties": false
          },
          "assert": {
            "type": "object",
            "properties": {
              "status": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "body": {
                "type": "object",
                "properties": {
                  "contains": {
                    "type": "string"
                  },
                  "equals": {
                    "type": "string"
                  },
                  "jsonPath": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "path"
                      ],
                      "properties": {
                        "path": {
                          "type": "string",
                          "description": "JSONPath subset: $, .key, and [n] steps."
                        },
                        "equals": {},
                        "contains": {
                          "type": "string"
                        },
                        "exists": {
                          "type": "boolean"
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "judges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "criteria": {
                  "type": "string"
                },
                "tools": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "maxRounds": {
                  "type": "integer",
                  "minimum": 0
                },
                "graders": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "exact",
                          "contains",
                          "not_contains",
                          "regex",
                          "json",
                          "expr"
                        ]
                      },
                      "pattern": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "judgeModel": {
            "type": "object",
            "description": "Model that reviews judges with criteria.",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "backend": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "repeat": {
            "type": "integer",
            "minimum": 1,
            "description": "Runs of the case (default 1)."
          },
          "threshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Pass rate the runs need (default 1: every run)."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "required": [
        "actionId",
        "name"
      ],
      "properties": {
        "apiVersion": {
          "type": "string",
          "enum": [
            "kdeps.io/v1"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "Resource"
          ]
        },
        "actionId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "workflow": {
          "type": "object",
          "properties": {
            "requires": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
