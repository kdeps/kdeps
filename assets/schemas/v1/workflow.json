{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "settings"
  ],
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": [
        "kdeps.io/v1"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "Workflow"
      ]
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "targetActionId"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "targetActionId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "apiServer": {
          "type": "object",
          "properties": {
            "hostIp": {
              "type": "string"
            },
            "portNum": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "routes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^/"
                  },
                  "methods": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "GET",
                        "POST",
                        "PUT",
                        "DELETE",
                        "PATCH"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "agentSettings": {
          "type": "object",
          "properties": {
            "timezone": {
              "type": "string"
            },
            "pythonVersion": {
              "type": "string"
            },
            "pythonPackages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "requirementsFile": {
              "type": "string"
            }
          }
        },
        "input": {
          "type": "object",
          "required": [
            "sources"
          ],
          "properties": {
            "sources": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "api",
                  "bot",
                  "file"
                ]
              }
            },
            "bot": {
              "type": "object",
              "properties": {
                "executionType": {
                  "type": "string",
                  "enum": [
                    "polling",
                    "stateless"
                  ]
                },
                "discord": {
                  "type": "object",
                  "properties": {
                    "guildId": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "slack": {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "telegram": {
                  "type": "object",
                  "properties": {
                    "pollIntervalSeconds": {
                      "type": "integer"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "file": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "certFile": {
          "type": "string"
        },
        "keyFile": {
          "type": "string"
        },
        "letsEncrypt": {
          "type": "object"
        },
        "webServer": {
          "type": "object"
        },
        "session": {
          "type": "object"
        },
        "llm": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "required": [
        "actionId",
        "name"
      ],
      "properties": {
        "apiVersion": {
          "type": "string",
          "enum": [
            "kdeps.io/v1"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "Resource"
          ]
        },
        "actionId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
