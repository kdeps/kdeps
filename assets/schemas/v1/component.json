{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": ["kdeps.io/v1"]
    },
    "kind": {
      "type": "string",
      "enum": ["Component"]
    },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "targetActionId": {
          "type": "string",
          "minLength": 1,
          "description": "ActionID of the resource that acts as the component entry point"
        }
      },
      "additionalProperties": false
    },
    "interface": {
      "type": "object",
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "enum": ["string", "integer", "number", "boolean"]
              },
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string"
              },
              "default": {},
              "connection": {
                "type": "string",
                "enum": ["search", "sql", "smtp", "imap", "http"],
                "description": "The input names a connection of this kind in ~/.kdeps/config.yaml; kdeps run prompts for a missing one."
              }
            },
            "additionalProperties": false
          }
        },
        "output": {
          "description": "The component's result, evaluated after its resources run (expressions resolved, maps and lists walked). Without it the result is the last resource's output."
        }
      },
      "additionalProperties": false
    },
    "pythonPackages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Deprecated: use setup.pythonPackages. Python packages merged into workflow agentSettings at load time."
    },
    "setup": {
      "type": "object",
      "properties": {
        "pythonPackages": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Python packages installed via 'uv pip install' before component resources run."
        },
        "osPackages": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "OS packages installed via apt-get/apk/brew before component resources run."
        },
        "provides": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Programs the osPackages install (e.g. tesseract). When all are on PATH, the OS package install is skipped."
        },
        "commands": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Shell commands run once before component resources execute."
        }
      },
      "additionalProperties": false
    },
    "teardown": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Shell commands run after component resources finish executing."
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "array"
    }
  },
  "additionalProperties": false
}
