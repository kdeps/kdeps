// kdeps-widget.js - the run UI for a --wasm bookmarklet. Two modes:
//  - overlay: injected into the page you're reading (window.__KDEPS_BOOKMARKLET,
//    served output). A floating panel; captures the page directly; the x button
//    removes it. No popup.
//  - popup: the app opened in its own small window via #kdeps-widget (the
//    file:// standalone fallback). Fills the window; the x button closes it.
// Both: show what the run is doing, collect any input the workflow needs,
// render the result as markdown, grow to fit, and never close on their own.
(function () {
    var OVERLAY = false;
    try { OVERLAY = !!window.__KDEPS_BOOKMARKLET; } catch (e) { OVERLAY = false; }

    function popupMode() {
        try {
            return /(?:^|[#&?])kdeps(?:-widget|=widget)\b/.test(location.hash + location.search);
        } catch (e) { return false; }
    }
    if (!OVERLAY && !popupMode()) return;

    var CFG = {};
    try { CFG = window.__KDEPS_SETTINGS || {}; } catch (e) { CFG = {}; }
    var appName = CFG.appName || 'kdeps';
    var captureFields = Array.isArray(CFG.captureFields) ? CFG.captureFields : [];
    var promptFields = Array.isArray(CFG.promptFields) ? CFG.promptFields : [];

    var captured = null;   // page fields for the workflow
    var ranOnce = false;
    var busy = false;

    // ---- minimal markdown -> html (LLM output: headings, lists, bold, code) --
    function esc(s) {
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }
    function inline(s) {
        return esc(s)
            .replace(/`([^`]+)`/g, '<code>$1</code>')
            .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
            .replace(/(^|[^*])\*([^*\n]+)\*/g, '$1<em>$2</em>')
            .replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
    }
    function markdown(src) {
        var lines = String(src == null ? '' : src).replace(/\r\n/g, '\n').split('\n');
        var out = [], para = [], list = null, i, fence = null;
        function flushPara() { if (para.length) { out.push('<p>' + inline(para.join(' ')) + '</p>'); para = []; } }
        function flushList() { if (list) { out.push('<' + list.tag + '>' + list.items.join('') + '</' + list.tag + '>'); list = null; } }
        for (i = 0; i < lines.length; i++) {
            var ln = lines[i];
            if (fence !== null) {
                if (/^```/.test(ln)) { out.push('<pre><code>' + esc(fence.join('\n')) + '</code></pre>'); fence = null; }
                else fence.push(ln);
                continue;
            }
            if (/^```/.test(ln)) { flushPara(); flushList(); fence = []; continue; }
            var h = /^(#{1,4})\s+(.*)$/.exec(ln);
            if (h) { flushPara(); flushList(); out.push('<h' + h[1].length + '>' + inline(h[2]) + '</h' + h[1].length + '>'); continue; }
            var ul = /^\s*[-*]\s+(.*)$/.exec(ln);
            var ol = /^\s*\d+\.\s+(.*)$/.exec(ln);
            if (ul || ol) {
                flushPara();
                var tag = ul ? 'ul' : 'ol';
                if (!list || list.tag !== tag) { flushList(); list = { tag: tag, items: [] }; }
                list.items.push('<li>' + inline((ul || ol)[1]) + '</li>');
                continue;
            }
            if (/^\s*$/.test(ln)) { flushPara(); flushList(); continue; }
            para.push(ln.trim());
        }
        if (fence !== null) out.push('<pre><code>' + esc(fence.join('\n')) + '</code></pre>');
        flushPara(); flushList();
        return out.join('\n');
    }

    // ---- result extraction (mirrors the example's summaryFrom heuristic) -----
    function resultText(r) {
        if (r == null) return '';
        if (typeof r === 'string') return r;
        if (r.response && typeof r.response === 'object') {
            if (typeof r.response.summary === 'string') return r.response.summary;
            if (typeof r.response.answer === 'string') return r.response.answer;
            if (typeof r.response === 'string') return r.response;
        }
        if (typeof r.response === 'string') return r.response;
        if (typeof r.summary === 'string') return r.summary;
        if (typeof r.answer === 'string') return r.answer;
        if (r.message && typeof r.message.content === 'string') return r.message.content;
        return '```json\n' + JSON.stringify(r, null, 2) + '\n```';
    }

    // ---- dom ---------------------------------------------------------------
    var els = {};
    function build() {
        var s = document.createElement('style');
        var frame = OVERLAY
            // Floating panel over the page you're reading.
            ? '#kdeps-widget{position:fixed;top:16px;right:16px;width:min(400px,92vw);max-height:82vh;' +
              'flex-direction:column;margin:0;border:1px solid #d1d5db;border-radius:12px;' +
              'box-shadow:0 24px 64px rgba(0,0,0,.18);' +
              'font:13px/1.5 system-ui,-apple-system,sans-serif;color:#111;background:#fff}'
            // Fills its own popup window; hide the app's own index.html.
            : 'body>*:not(#kdeps-widget):not(.kdeps-drawer):not(.kdeps-backdrop):not(.kdeps-gear)' +
              '{display:none!important}' +
              '#kdeps-widget{position:fixed;inset:0;flex-direction:column;margin:0;' +
              'font:13px/1.5 system-ui,-apple-system,sans-serif;color:#111;background:#fff}';
        s.textContent = '#kdeps-widget{display:flex!important;z-index:2147483000}' + frame +
            '#kdeps-widget header{display:flex;align-items:center;gap:.5rem;padding:.55rem .7rem;' +
            'border-bottom:1px solid #eee;font-weight:600}' +
            '#kdeps-widget header .sp{margin-left:auto}' +
            '#kdeps-widget header button{border:0;background:none;line-height:1;cursor:pointer;color:#666}' +
            '#kdeps-widget header .cfg{font-size:14px}' +
            '#kdeps-widget button.x{font-size:16px}' +
            '#kdeps-widget .body{padding:.7rem;overflow:auto;flex:1}' +
            '#kdeps-widget .status{color:#555;display:flex;align-items:center;gap:.5rem}' +
            '#kdeps-widget .spin{width:12px;height:12px;border:2px solid #ddd;border-top-color:#111;' +
            'border-radius:50%;animation:kds .8s linear infinite}' +
            '@keyframes kds{to{transform:rotate(360deg)}}' +
            '#kdeps-widget label{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.05em;' +
            'color:#666;margin:.5rem 0 .2rem}' +
            '#kdeps-widget textarea,#kdeps-widget input{width:100%;box-sizing:border-box;padding:.45rem;' +
            'border:1px solid #ccc;border-radius:2px;font:inherit}' +
            '#kdeps-widget textarea{min-height:3.5rem;resize:vertical}' +
            '#kdeps-widget .run{margin-top:.55rem;padding:.45rem .9rem;border:0;border-radius:2px;' +
            'background:#111;color:#fff;cursor:pointer;font:inherit}' +
            '#kdeps-widget .run:disabled{opacity:.5;cursor:default}' +
            '#kdeps-widget .out{margin-top:.6rem}' +
            '#kdeps-widget .out h1,#kdeps-widget .out h2,#kdeps-widget .out h3{font-size:1em;margin:.6rem 0 .3rem}' +
            '#kdeps-widget .out p{margin:.4rem 0}#kdeps-widget .out ul,#kdeps-widget .out ol{margin:.4rem 0 .4rem 1.1rem}' +
            '#kdeps-widget .out pre{background:#f5f5f5;padding:.5rem;overflow:auto;border-radius:2px}' +
            '#kdeps-widget .out code{background:#f0f0f0;padding:.05rem .25rem;border-radius:2px}' +
            '#kdeps-widget .err{color:#b91c1c;white-space:pre-wrap}';
        document.head.appendChild(s);

        var w = document.createElement('div');
        w.id = 'kdeps-widget';
        w.innerHTML =
            '<header><span>' + esc(appName) + '</span><span class="sp"></span>' +
            '<button class="cfg" type="button" title="Settings" aria-label="Settings">⚙</button>' +
            '<button class="x" type="button" title="Dismiss" aria-label="Dismiss">✕</button></header>' +
            '<div class="body">' +
            '<div class="status"><span class="spin" hidden></span><span class="msg">Waiting for the page…</span></div>' +
            '<div class="inputs"></div>' +
            '<div class="out"></div>' +
            '</div>';
        (document.body || document.documentElement).appendChild(w);
        els.root = w;
        els.spin = w.querySelector('.spin');
        els.msg = w.querySelector('.msg');
        els.inputs = w.querySelector('.inputs');
        els.out = w.querySelector('.out');
        w.querySelector('.x').addEventListener('click', function () {
            if (OVERLAY) w.remove(); else window.close();
        });
        w.querySelector('.cfg').addEventListener('click', function () {
            if (typeof window.__kdepsOpenSettings === 'function') window.__kdepsOpenSettings();
        });
    }

    function status(msg, spinning) {
        if (els.msg) els.msg.textContent = msg;
        if (els.spin) els.spin.hidden = !spinning;
    }
    function grow() {
        if (OVERLAY) return; // the panel already grows with its content (max-height + overflow)
        try { window.resizeTo(Math.min(screen.availWidth - 40, 460), Math.min(screen.availHeight - 40, 560)); } catch (e) {}
    }

    function renderInputs() {
        els.inputs.innerHTML = '';
        if (!promptFields.length) return;
        promptFields.forEach(function (f) {
            var l = document.createElement('label'); l.textContent = f; l.htmlFor = 'kdw-' + f;
            var ta = document.createElement('textarea'); ta.id = 'kdw-' + f; ta.dataset.field = f;
            els.inputs.appendChild(l); els.inputs.appendChild(ta);
        });
        var run = document.createElement('button');
        run.className = 'run'; run.type = 'button'; run.textContent = 'Run ' + appName;
        run.addEventListener('click', function () { execute(); });
        els.inputs.appendChild(run);
        els.run = run;
    }

    function collectInput() {
        var input = {};
        if (captured) for (var k in captured) if (captured.hasOwnProperty(k)) input[k] = captured[k];
        els.inputs.querySelectorAll('textarea[data-field]').forEach(function (ta) {
            if (ta.value.trim()) input[ta.dataset.field] = ta.value.trim();
        });
        return input;
    }

    async function execute() {
        if (busy) return;
        if (!window.kdeps) { status('Runtime not ready yet…', true); return; }
        if (window.__kdepsSettingsReady && !window.__kdepsSettingsReady()) {
            status('Open the gear menu and set a backend + API key first.', false);
            return;
        }
        var input = collectInput();
        var missing = promptFields.filter(function (f) { return !input[f]; });
        if (missing.length) { status('Fill in: ' + missing.join(', '), false); return; }

        busy = true; ranOnce = true;
        if (els.run) els.run.disabled = true;
        els.out.innerHTML = '';
        status('Running ' + appName + '…', true);
        try {
            var res = await window.kdeps.execute(input);
            els.out.innerHTML = markdown(resultText(res));
            status('Done.', false);
            grow();
        } catch (err) {
            var m = document.createElement('div'); m.className = 'err';
            m.textContent = String(err && err.message ? err.message : err);
            els.out.appendChild(m);
            status('Failed.', false);
            grow();
        }
        busy = false;
        if (els.run) els.run.disabled = false;
    }

    function maybeAutoRun() {
        // Auto-run once we have the captured page and nothing else is needed.
        if (ranOnce || busy) return;
        if (captureFields.length && !captured) return;      // still waiting for the bookmarklet
        if (promptFields.length) { status('Enter the input below, then Run.', false); return; }
        execute();
    }

    // Read the page's own text, with kdeps' injected UI (this panel, the
    // drawer, overlays) hidden so it never pollutes the summary input.
    function pageText() {
        var hidden = [];
        var kd = document.querySelectorAll(
            '#kdeps-widget,.kdeps-drawer,.kdeps-gear,.kdeps-backdrop,' +
            '#kdeps-boot-overlay,.kdeps-capture,#kdeps-settings,#kdeps-loading');
        for (var i = 0; i < kd.length; i++) {
            hidden.push([kd[i], kd[i].style.display]);
            kd[i].style.display = 'none';
        }
        var text = ((document.body && document.body.innerText) || '').slice(0, 24000);
        for (var j = 0; j < hidden.length; j++) hidden[j][0].style.display = hidden[j][1];
        return text;
    }

    function pageFields() {
        var v = { url: location.href, title: document.title, text: pageText() };
        var out = {};
        captureFields.forEach(function (f) { out[f] = v[f] != null ? v[f] : v.text; });
        return out;
    }

    // ---- capture transport --------------------------------------------------
    // Overlay mode reads the page directly; popup mode receives the payload the
    // bookmarklet posts (postMessage / window.name / clipboard).
    function applyPayload(p) {
        if (!p || p.__kdepsCapture !== 1) return false;
        captured = {};
        captureFields.forEach(function (f) { if (p[f] != null) captured[f] = p[f]; });
        status('Page received.', false);
        maybeAutoRun();
        return true;
    }
    var clipCaptured = false;
    // Read the clipboard ONLY when permission is already granted - a readText()
    // call while permission is "prompt" pops a dialog on every focus, and the
    // file:// grant never sticks, so it loops. postMessage + window.name are
    // the primary transports anyway.
    function readClipboard() {
        if (OVERLAY || clipCaptured || !navigator.clipboard || !navigator.clipboard.readText) return;
        if (!navigator.permissions || !navigator.permissions.query) return;
        navigator.permissions.query({ name: 'clipboard-read' }).then(function (p) {
            if (p.state !== 'granted') return;
            navigator.clipboard.readText().then(function (raw) {
                try { if (applyPayload(JSON.parse(raw))) clipCaptured = true; } catch (e) {}
            }).catch(function () {});
        }).catch(function () {});
    }
    if (!OVERLAY) {
        window.addEventListener('message', function (ev) { applyPayload(ev.data); });
        window.addEventListener('focus', readClipboard);
        try { applyPayload(JSON.parse(window.name)); } catch (e) {}
    }

    // Retry once the viewer sets a backend/key in the drawer.
    window.addEventListener('kdeps:settings-changed', function () {
        if (!ranOnce) maybeAutoRun();
    });

    function start() {
        build();
        renderInputs();
        if (OVERLAY && captureFields.length) captured = pageFields();
        readClipboard();
        if (window.kdeps) {
            status('Ready.', false);
            maybeAutoRun();
        } else {
            status('Loading the runtime…', true);
            window.addEventListener('kdeps:loading', function () { status('Loading the runtime…', true); });
            window.addEventListener('kdeps:error', function () { status('Failed to load the runtime.', false); });
            window.addEventListener('kdeps:ready', function () { status('Ready.', false); maybeAutoRun(); });
        }
        // If no capture is expected and no input needed, run as soon as we can.
        if (!captureFields.length) maybeAutoRun();
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
    else start();
})();
