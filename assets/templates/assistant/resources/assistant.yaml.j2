actionId: assistant
name: Assistant

chat:
  model:
    name: ministral3   # local 3B llamafile (3.2 GB), no API key; a 1B model does not call tools. Set backend: and a model for a cloud provider
  context:
    prompt: "{% raw %}{{ input('message') }}{% endraw %}"
  loop:
    # The agent works on the files of the folder you run it from.
    tools: [read_file, edit_file, write_file, list_files, search_local, bash_exec]
    maxRounds: 25
    session: "{% raw %}{{ get('session') }}{% endraw %}"   # the prompt's session: one conversation across lines
