apiVersion: kdeps.io/v1
kind: Workflow

metadata:
  name: {{ name }}
  description: {{ description }}
  version: "{{ version }}"
  targetActionId: reply

deploy:
  input:
    listen:
      # POST /whatsapp on :16396. Answers Meta's verification GET and checks
      # X-Hub-Signature-256 on every POST; each signed notification is one run.
      - listener: whatsapp_webhook
