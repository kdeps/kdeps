apiVersion: kdeps.io/v1
kind: Resource
metadata:
  actionId: python
  name: Python Script
  description: Execute Python code
component:
  name: python
  with:
    script: |
      # Your Python code here
      import json

      # Access input via expressions
      input_data = "{% raw %}{{ get('input', '{}') }}{% endraw %}"

      # Process data
      result = {"processed": True, "input": input_data}

      # Output result as JSON (captured as the resource output)
      print(json.dumps(result))
    timeout: 60s
